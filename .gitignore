# Scripts (local only)
scripts/

# Package lock (use package.json only)
package-lock.json

# Uploaded files (user-generated content)
uploads/

# Backend performance suggestions (local only)
backend_suggestion/

# Local runtime artifacts
*.err
afrita.err

# Middleware test artifacts (token cookies)
middleware/*.json

