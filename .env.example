# =============================================================================
# afrita-go (frontend) — local-dev configuration
# =============================================================================
# Copy this file:
#   cp .env.example .env
# `.env.local` (gitignored) overrides values in `.env`.
# =============================================================================

# HTTP port the Go server listens on (default 8000).
PORT=8000

# Public-facing domain for this frontend. Used for cookie scoping in
# handlers/auth.go and logged at startup. Use `localhost` for local dev.
APP_DOMAIN=localhost

# Base URL of the ifritah-go backend API. The frontend proxies /api/* there.
# When running both via docker-compose, the backend service is reachable at
# http://backend:8090 on the compose network. For host-only dev use
# http://localhost:8090.
BACKEND_URL=http://backend:8090

# Directory where the frontend persists OAuth/session tokens (mode 0700).
# Defaults to the OS user-config dir; in a container we write under /app/data
# which is mounted as a named volume in docker-compose.yml.
AFRITA_TOKEN_DIR=/app/data/tokens
