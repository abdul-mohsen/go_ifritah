\n            </div>\r\n\r\n            <button type=\"submit\"\r\n                class=\"w-full py-2.5 rounded-lg font-bold transition text-sm flex items-center justify-center gap-2\"\r\n                style=\"background: var(--md-sys-color-primary); color: var(--md-sys-color-on-primary)\">\r\n                <svg id=\"login-spinner\" class=\"htmx-indicator animate-spin h-4 w-4 text-white\"\r\n                    xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\r\n                    <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\" />\r\n                    <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z\" />\r\n                </svg>\r\n                تسجيل الدخول\r\n            </button>\r\n        </form>\r\n\r\n        <div class=\"mt-5 text-center space-y-1.5\">\r\n            <p class=\"login-subtitle text-xs\">ليس لديك حساب؟ <a href=\"/register\" class=\"hover:underline font-semibold\"\r\n                    style=\"color: var(--md-sys-color-primary)\">سجل هنا</a></p>\r\n            <p class=\"login-subtitle text-xs\"><a href=\"/forgot-password\" class=\"hover:underline\"\r\n                    style=\"color: var(--md-sys-color-primary)\">نسيت كلمة المرور؟</a></p>\r\n        </div>\r\n    </div>\r\n\r\n    \r\n    <footer class=\"mt-6 mb-4 text-center\">\r\n        <p class=\"text-xs\" style=\"color: var(--md-sys-color-on-surface-variant)\">عفريته v0.6.0 © 2024-2026</p>\r\n        <p class=\"text-[10px]\" style=\"color: var(--md-sys-color-outline)\">جميع الحقوق محفوظة</p>\r\n    </footer>\r\n    <script src=\"/static/js/i18n.js\"></script>\r\n\r\n    \r\n    <div id=\"toast-container\"></div>\r\n    <script>\r\n        document.body.addEventListener('showToast', function (e) {\r\n            var d = e.detail || {};\r\n            var type = d.type || 'error';\r\n            var msg = d.message || 'خطأ غير متوقع';\r\n            var